# Hybrid Search RAG - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Configuration
# =============================================================================
API_TITLE="Hybrid RAG Research API"
API_VERSION="1.0.0"
API_HOST="0.0.0.0"
API_PORT=8000

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION="us-east-1"
AWS_ACCOUNT_ID="your-aws-account-id"

# S3 Buckets
S3_BUCKET_DOCUMENTS="hybrid-rag-documents-dev"
S3_BUCKET_LOGS="hybrid-rag-logs-dev"
S3_BUCKET_ARTIFACTS="hybrid-rag-artifacts-dev"

# AWS Secrets Manager
AWS_SECRETS_NAME="hybrid-rag-secrets-dev"

# =============================================================================
# Database URLs (Local Development)
# =============================================================================
# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="research_papers"
QDRANT_API_KEY=""  # Optional, for cloud Qdrant

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX="research_papers"
ELASTICSEARCH_USERNAME=""  # Optional
ELASTICSEARCH_PASSWORD=""  # Optional

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""  # Optional

# =============================================================================
# LLM API Keys (Development - Use AWS Secrets Manager in Production)
# =============================================================================
# For local development, you can set these here
# In production, these will be loaded from AWS Secrets Manager
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
COHERE_API_KEY="your-cohere-api-key-here"
COMET_ML_API_KEY="your-comet-ml-api-key-here"

# =============================================================================
# Embedding Configuration
# =============================================================================
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# Chunking Configuration
# =============================================================================
# Chunk size in tokens
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Chunking strategy: token, semantic, sdpm, academic
DEFAULT_CHUNKING_STRATEGY="semantic"

# =============================================================================
# Search Configuration
# =============================================================================
# Number of results to retrieve
RETRIEVAL_TOP_K=20

# Reranking
RERANKER_TOP_K=10
RERANKER_MODEL="rerank-english-v3.0"

# Hybrid search weights
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5

# =============================================================================
# LLM Generation Configuration
# =============================================================================
# Primary LLM
PRIMARY_LLM="claude-sonnet-4-20250514"
FALLBACK_LLM="gpt-4"

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_STREAMING=true

# =============================================================================
# Observability Configuration
# =============================================================================
# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"  # json or text

# OPIK
OPIK_ENABLED=true
OPIK_PROJECT_NAME="hybrid-rag-research"

# Comet ML
COMET_ML_PROJECT="hybrid-rag-research"
COMET_ML_WORKSPACE="your-workspace"

# =============================================================================
# Performance Configuration
# =============================================================================
# Caching
ENABLE_CACHE=true
CACHE_TTL=3600  # seconds

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Connection pooling
MAX_CONNECTIONS=100

# =============================================================================
# Development/Debug
# =============================================================================
DEBUG=false
ENVIRONMENT="dev"  # dev, staging, prod
